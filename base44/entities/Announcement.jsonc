{
  "name": "Announcement",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "all",
        "specific_users"
      ],
      "default": "all"
    },
    "target_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_user_emails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "attachment_url": {
      "type": "string"
    },
    "pinned": {
      "type": "boolean",
      "default": false
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "email": "suhendra.a.d@gmail.com"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "email": "suhendra.a.d@gmail.com"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "email": "suhendra.a.d@gmail.com"
          }
        }
      ]
    }
  }
}