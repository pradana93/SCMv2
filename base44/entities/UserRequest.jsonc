{
  "name": "UserRequest",
  "type": "object",
  "properties": {
    "email": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "requested_role": {
      "type": "string",
      "enum": [
        "crew",
        "staff",
        "supervisor",
        "admin",
        "super_admin"
      ],
      "default": "crew"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    }
  },
  "required": [
    "email",
    "status"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}