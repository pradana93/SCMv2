{
  "name": "Accurate Auto Sync",
  "description": "Sinkronisasi otomatis setiap transaksi stok baru (StockMovement) ke Accurate Online saat auto_sync aktif",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "StockMovement",
      "events": [
        "create"
      ]
    },
    "condition": "${ .trigger.data.accurate_synced != true }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "accurate_auto_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_movement": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "accurateAutoSync",
            "args": {
              "movement_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Sync ke Accurate",
            "description": "Sinkron transaksi stok baru"
          }
        }
      }
    ]
  }
}